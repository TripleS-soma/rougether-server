aws_region  = "ap-northeast-2"
environment = "dev"

# 기본 VPC가 없는 신규/샌드박스 계정에서만 true.
create_network = false

# 개인정보성 bug-reports prefix를 비공개로 보장하기 위해 관리형 private S3 + CloudFront가 필수.
create_asset_bucket = true
# 생략하면 <project>-<environment>-<AWS account ID>-assets 형식의 고유 이름을 사용합니다.
# 기존 버킷을 이 스택으로 이전할 때만 이름을 명시하고 먼저 terraform import를 수행하세요.
# asset_bucket_name = "globally-unique-bucket-name"
# asset_region은 생략하면 aws_region을 사용합니다.

# Leave null to use Terraform-managed private ECR repositories.
# Override only when deploying from another registry.
user_api_image  = null
admin_api_image = null

# Leave null to use Terraform-managed ECR login on EC2.
# For another private registry, store a token in SSM SecureString and set both values.
container_registry_server                 = null
container_registry_username               = null
container_registry_password_ssm_parameter = null

# admin-api는 localhost + 암호화된 SSM 터널로만 접근합니다.
allowed_user_api_cidrs  = ["0.0.0.0/0"]
allowed_admin_api_cidrs = []
allowed_ssh_cidrs       = []

# Optional. Leave null and use SSM Session Manager instead of SSH.
key_name = null

# Free Tier eligibility depends on account creation date and current AWS offers.
instance_type     = "t3.micro"
db_instance_class = "db.t3.micro"

admin_seed_username = "admin"
# admin_seed_password = "replace-with-a-strong-password"

# jwt_secret = "replace-with-at-least-32-random-bytes"
# 로컬 IDE 에서 RDS 3306 직접 접속을 허용할 개인 IP (선택, 비우면 SSM 터널만)
db_direct_access_cidrs  = []

# half-baked 베이스 AMI (deploy/packer 로 먼저 빌드한 뒤 true 로 전환).
# 인스턴스 lifecycle 이 ami 를 무시하므로 실제 교체는 terraform apply -replace=aws_instance.app
# use_baked_ami = true
