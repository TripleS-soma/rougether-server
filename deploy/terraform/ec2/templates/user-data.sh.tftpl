#!/bin/bash
set -euo pipefail

${runtime_env_helpers}

exec > >(tee -a /var/log/rougether-user-data.log) 2>&1

ENV_DIR="/etc/rougether"
FIREBASE_CREDENTIALS_FILE="$ENV_DIR/firebase-adminsdk.json"

umask 077

%{ if use_baked_ami ~}
# half-baked AMI(rougether-base): docker/awscli/python3/유닛 정의는 이미 구워져 있다.
# 여기서는 인스턴스 고유·가변 레이어(시크릿, env, 이미지 pull, 기동)만 처리한다.
%{ else ~}
dnf update -y
dnf install -y docker awscli python3 nginx
%{ endif ~}
systemctl enable --now docker

if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

mkdir -p "$ENV_DIR"
chmod 700 "$ENV_DIR"

export AWS_REGION='${aws_region}'
DB_PASSWORD="$(aws ssm get-parameter --name '${db_password_param}' --with-decryption --query 'Parameter.Value' --output text --region '${aws_region}')"
JWT_SECRET="$(aws ssm get-parameter --name '${jwt_secret_param}' --with-decryption --query 'Parameter.Value' --output text --region '${aws_region}')"
ADMIN_SEED_PASSWORD="$(aws ssm get-parameter --name '${admin_seed_password_param}' --with-decryption --query 'Parameter.Value' --output text --region '${aws_region}')"
ADMIN_ORIGIN_SECRET="$(aws ssm get-parameter --name '${admin_origin_secret_param}' --with-decryption --query 'Parameter.Value' --output text --region '${aws_region}')"
WEBEX_BOT_TOKEN="$(aws ssm get-parameter --name '${webex_bot_token_param}' --with-decryption --query 'Parameter.Value' --output text --region '${aws_region}' 2>/dev/null || true)"
WEBEX_ROOM_ID="$(aws ssm get-parameter --name '${webex_room_id_param}' --query 'Parameter.Value' --output text --region '${aws_region}' 2>/dev/null || true)"
KAKAO_ADMIN_KEY="$(aws ssm get-parameter --name '${kakao_admin_key_param}' --with-decryption --query 'Parameter.Value' --output text --region '${aws_region}' 2>/dev/null || true)"
APPLE_TEAM_ID="$(aws ssm get-parameter --name '${apple_team_id_param}' --with-decryption --query 'Parameter.Value' --output text --region '${aws_region}' 2>/dev/null || true)"
APPLE_KEY_ID="$(aws ssm get-parameter --name '${apple_key_id_param}' --with-decryption --query 'Parameter.Value' --output text --region '${aws_region}' 2>/dev/null || true)"
APPLE_PRIVATE_KEY="$(aws ssm get-parameter --name '${apple_private_key_param}' --with-decryption --query 'Parameter.Value' --output text --region '${aws_region}' 2>/dev/null || true)"
APPLE_REFRESH_TOKEN_ENC_KEY="$(aws ssm get-parameter --name '${apple_refresh_token_enc_key_param}' --with-decryption --query 'Parameter.Value' --output text --region '${aws_region}' 2>/dev/null || true)"
LLM_API_KEY="$(aws ssm get-parameter --name '${llm_api_key_param}' --with-decryption --query 'Parameter.Value' --output text --region '${aws_region}' 2>/dev/null || true)"
APPLE_PRIVATE_KEY="$(printf '%s' "$APPLE_PRIVATE_KEY" | escape_multiline_env_value)"

webex_bot_token_valid() {
  python3 -c '
import sys

value = sys.stdin.read().strip()
valid = bool(value) and len(value) <= 2048 and not any(character.isspace() for character in value)
raise SystemExit(0 if valid else 1)
'
}

webex_room_id_valid() {
  python3 -c '
import sys

value = sys.stdin.read().strip()
valid = bool(value) and len(value) <= 1024 and not any(character.isspace() for character in value)
raise SystemExit(0 if valid else 1)
'
}

firebase_credentials_valid() {
  local credentials_file="$1"

  [ -f "$credentials_file" ] || return 1

  python3 - "$credentials_file" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as credentials_file:
        credentials = json.load(credentials_file)
except (OSError, json.JSONDecodeError):
    raise SystemExit(1)

required = ("project_id", "private_key", "client_email")
if credentials.get("type") != "service_account" or any(not credentials.get(key) for key in required):
    raise SystemExit(1)
PY
}

write_firebase_credentials() {
  local temporary_file
  temporary_file="$(mktemp "$ENV_DIR/.firebase-adminsdk.json.XXXXXX")"

  if ! aws ssm get-parameter --name '${firebase_credentials_param}' --with-decryption \
    --query 'Parameter.Value' --output text --region '${aws_region}' > "$temporary_file"; then
    rm -f "$temporary_file"
    return 1
  fi

  if ! firebase_credentials_valid "$temporary_file"; then
    rm -f "$temporary_file"
    return 1
  fi

  chmod 600 "$temporary_file"
  chown root:root "$temporary_file"
  mv -f "$temporary_file" "$FIREBASE_CREDENTIALS_FILE"
}

firebase_mount_option=""
if write_firebase_credentials; then
  echo "Firebase credentials refreshed from SSM"
elif firebase_credentials_valid "$FIREBASE_CREDENTIALS_FILE"; then
  echo "Firebase credentials unavailable in SSM; keeping the current credentials" >&2
else
  echo "Firebase credentials unavailable; user-api will start with the FCM stub" >&2
fi

if firebase_credentials_valid "$FIREBASE_CREDENTIALS_FILE"; then
  firebase_mount_option="-v /etc/rougether/firebase-adminsdk.json:/etc/rougether/firebase-adminsdk.json:ro"
fi

cat > "$ENV_DIR/user-api.env" <<EOF
SPRING_PROFILES_ACTIVE=mysql
SERVER_PORT=8080
DB_URL=${db_url}
DB_USERNAME=${db_username}
DB_PASSWORD=$DB_PASSWORD
JWT_SECRET=$JWT_SECRET
ASSET_S3_BUCKET=${asset_bucket_name}
ASSET_S3_REGION=${asset_region}
ASSET_S3_PURGE_VERSIONS=${asset_purge_versions}
KAKAO_ADMIN_KEY=$KAKAO_ADMIN_KEY
APPLE_TEAM_ID=$APPLE_TEAM_ID
APPLE_KEY_ID=$APPLE_KEY_ID
APPLE_PRIVATE_KEY=$APPLE_PRIVATE_KEY
APPLE_REFRESH_TOKEN_ENC_KEY=$APPLE_REFRESH_TOKEN_ENC_KEY
EOF

if firebase_credentials_valid "$FIREBASE_CREDENTIALS_FILE"; then
  printf '\nFIREBASE_CREDENTIALS_PATH=/etc/rougether/firebase-adminsdk.json\n' >> "$ENV_DIR/user-api.env"
fi

printf '\nROUGETHER_ENVIRONMENT=${environment}\n' >> "$ENV_DIR/user-api.env"
if printf '%s' "$WEBEX_ROOM_ID" | webex_room_id_valid; then
  printf 'OPERATIONS_WEBEX_ROOM_ID=%s\n' "$WEBEX_ROOM_ID" >> "$ENV_DIR/user-api.env"
else
  echo "Webex room ID unavailable or invalid; operational alerts are disabled" >&2
fi
if printf '%s' "$WEBEX_BOT_TOKEN" | webex_bot_token_valid; then
  printf 'OPERATIONS_WEBEX_BOT_TOKEN=%s\n' "$WEBEX_BOT_TOKEN" >> "$ENV_DIR/user-api.env"
else
  echo "Webex bot token unavailable or invalid; operational alerts are disabled" >&2
fi

cat > "$ENV_DIR/admin-api.env" <<EOF
SPRING_PROFILES_ACTIVE=mysql
SERVER_PORT=8081
DB_URL=${db_url}
DB_USERNAME=${db_username}
DB_PASSWORD=$DB_PASSWORD
ADMIN_SEED_ENABLED=${admin_seed_enabled}
ADMIN_SEED_USERNAME=${admin_seed_username}
ADMIN_SEED_PASSWORD=$ADMIN_SEED_PASSWORD
ADMIN_ORIGIN_SECRET=$ADMIN_ORIGIN_SECRET
ASSET_S3_BUCKET=${asset_bucket_name}
ASSET_S3_REGION=${asset_region}
ASSET_PUBLIC_BASE_URL=${asset_public_base_url}
EOF

# batch: 루틴 리마인드·day-end·주간 회고 등 배치 전용. 외부 접근 없이 localhost 헬스체크(8082)만 노출한다.
# firebase 자격증명이 있으면 user-api 와 동일하게 마운트해 실제 FCM 을 발송하고, 없으면 stub 으로 동작한다.
# LLM API 키가 SSM 에 없으면 줄을 쓰지 않는다 — batch 는 키가 비면 LLM stub 으로 뜨고 주간 회고 생성만 보류한다.
cat > "$ENV_DIR/batch.env" <<EOF
SPRING_PROFILES_ACTIVE=mysql
SERVER_PORT=8082
DB_URL=${db_url}
DB_USERNAME=${db_username}
DB_PASSWORD=$DB_PASSWORD
EOF

if firebase_credentials_valid "$FIREBASE_CREDENTIALS_FILE"; then
  printf '\nFIREBASE_CREDENTIALS_PATH=/etc/rougether/firebase-adminsdk.json\n' >> "$ENV_DIR/batch.env"
fi

# LLM API 키: batch(주간 회고)와 user-api(유사 루틴 비교 임베딩, #303) 둘 다 쓴다. 비면 각각 stub 으로 뜬다
if [ -n "$LLM_API_KEY" ]; then
  printf '\nLLM_API_KEY=%s\n' "$LLM_API_KEY" >> "$ENV_DIR/batch.env"
  printf '\nLLM_API_KEY=%s\n' "$LLM_API_KEY" >> "$ENV_DIR/user-api.env"
fi

chmod 600 "$ENV_DIR/user-api.env" "$ENV_DIR/admin-api.env" "$ENV_DIR/batch.env"

if [[ '${registry_server}' == *.dkr.ecr.*.amazonaws.com ]]; then
  aws ecr get-login-password --region '${aws_region}' | docker login '${registry_server}' --username AWS --password-stdin
elif [ -n '${registry_password_param}' ] && [ -n '${registry_username}' ]; then
  REGISTRY_PASSWORD="$(aws ssm get-parameter --name '${registry_password_param}' --with-decryption --query 'Parameter.Value' --output text --region '${aws_region}')"
  printf '%s' "$REGISTRY_PASSWORD" | docker login '${registry_server}' --username '${registry_username}' --password-stdin
fi

docker pull ${user_api_image}
docker pull ${admin_api_image}
docker pull ${batch_image}

cat > "$ENV_DIR/user-api-blue.deploy.env" <<EOF
ROUGETHER_IMAGE=${user_api_image}
ROUGETHER_HOST_PORT=18080
EOF

cat > "$ENV_DIR/admin-api-blue.deploy.env" <<EOF
ROUGETHER_IMAGE=${admin_api_image}
ROUGETHER_HOST_PORT=18081
EOF

cat > "$ENV_DIR/batch.deploy.env" <<EOF
ROUGETHER_BATCH_IMAGE=${batch_image}
EOF

cat > "$ENV_DIR/deploy-state.env" <<EOF
USER_API_IMAGE=${user_api_image}
USER_API_ACTIVE_COLOR=blue
USER_API_ACTIVE_PORT=18080
ADMIN_API_IMAGE=${admin_api_image}
ADMIN_API_ACTIVE_COLOR=blue
ADMIN_API_ACTIVE_PORT=18081
BATCH_API_IMAGE=${batch_image}
DEPLOYMENT_STATUS=ready
DEPLOYED_SHA=bootstrap
TARGET_SHA=bootstrap
DEPLOYED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF

chmod 600 "$ENV_DIR/user-api-blue.deploy.env" "$ENV_DIR/admin-api-blue.deploy.env" "$ENV_DIR/batch.deploy.env" "$ENV_DIR/deploy-state.env"

%{ if use_baked_ami ~}
# 유닛 정의는 AMI 에 구워져 있다 (deploy/packer/files/*.service).
# GitHub Actions blue/green 배포가 같은 template 유닛을 최신 메모리 정책으로 덮어쓴다.
%{ else ~}
# 순정 AL2023 폴백: deploy/packer/files 정본을 templatefile 로 주입받아 설치한다.
# 주의: 유닛 사본은 배포 스크립트(write_blue_green_units)에도 있으므로 수정 시 함께 갱신할 것.
cat > /etc/systemd/system/rougether-user-api@.service <<'EOF'
${user_api_blue_green_unit}
EOF

cat > /etc/systemd/system/rougether-admin-api@.service <<'EOF'
${admin_api_blue_green_unit}
EOF

cat > /etc/systemd/system/rougether-batch.service <<'EOF'
${batch_unit}
EOF

mkdir -p /etc/nginx/conf.d
cat > /etc/nginx/conf.d/rougether.conf <<'EOF'
${blue_green_nginx_config}
EOF
%{ endif ~}

# baked AMI 에 유닛이 실제로 구워졌는지 확인 — 잘못된 AMI 로 떴을 때 set -e 로 조용히 죽는 대신 원인을 남긴다
for unit_file in rougether-user-api@.service rougether-admin-api@.service rougether-batch.service; do
  if [ ! -f "/etc/systemd/system/$unit_file" ]; then
    echo "ERROR: /etc/systemd/system/$unit_file 가 없습니다 — rougether-base AMI 가 아니거나 베이크가 누락됐습니다 (deploy/packer/README.md 참고)" >&2
    exit 1
  fi
done

sed -i "s|__FIREBASE_MOUNT_OPTION__|$firebase_mount_option|" /etc/systemd/system/rougether-user-api@.service
sed -i "s|__FIREBASE_MOUNT_OPTION__|$firebase_mount_option|" /etc/systemd/system/rougether-batch.service

PRIVATE_IP="$(ip -4 route get 1.1.1.1 | awk '{for (i = 1; i <= NF; i++) if ($i == "src") {print $(i + 1); exit}}')"
if [ -z "$PRIVATE_IP" ]; then
  echo "ERROR: admin Nginx upstream에 사용할 private IP를 찾지 못했습니다" >&2
  exit 1
fi
sed -i "s|server 127.0.0.1:18081;|server $PRIVATE_IP:18081;|" /etc/nginx/conf.d/rougether.conf
nginx -t

systemctl daemon-reload
systemctl enable rougether-user-api@blue rougether-admin-api@blue rougether-batch nginx

# 초기 부트스트랩은 blue backend를 내부 포트에서 검증한 뒤 Nginx가 고정 포트를 소유한다.
# 이후 배포는 한 API 후보씩만 추가 기동하는 동일 호스트 blue/green 경로를 사용한다.
wait_for_bootstrap_health() {
  local name="$1"
  local url="$2"

  for attempt in $(seq 1 120); do
    if curl --fail --silent --show-error --connect-timeout 2 --max-time 5 "$url" >/dev/null; then
      echo "$name bootstrap health check passed"
      return 0
    fi

    echo "waiting for $name bootstrap health check ($attempt/120)"
    sleep 5
  done

  echo "$name bootstrap health check failed" >&2
  return 1
}

systemctl restart rougether-user-api@blue
wait_for_bootstrap_health user-api-blue http://127.0.0.1:18080/api/v1/health
systemctl restart rougether-admin-api@blue
wait_for_bootstrap_health admin-api-blue http://127.0.0.1:18081/admin/health
systemctl restart nginx
wait_for_bootstrap_health user-api-proxy http://127.0.0.1:8080/api/v1/health
wait_for_bootstrap_health admin-api-proxy http://127.0.0.1:8081/admin/health
systemctl restart rougether-batch
wait_for_bootstrap_health batch http://127.0.0.1:8082/actuator/health
