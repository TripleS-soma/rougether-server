# .env로 복사한 뒤 실제 값을 주입한다. .env는 커밋하지 않는다.
# python -c 'import secrets; print(secrets.token_urlsafe(48))' 로 별도 내부 토큰 생성
AI_SERVICE_TOKEN=replace-with-a-random-service-token-at-least-32-characters
AI_PROVIDER_API_KEY=replace-with-provider-api-key
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-5.6-luna
AI_EMBEDDING_MODEL=text-embedding-3-large
AI_EMBEDDING_DIMENSIONS=1024
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_CHAT_CONCURRENCY=2
AI_EMBEDDING_CONCURRENCY=2
