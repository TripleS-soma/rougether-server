{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rougether.dev/schemas/asset-manifest.v1.json",
  "title": "Rougether Asset Foundry Manifest",
  "type": "object",
  "required": ["schemaVersion", "name", "slug", "kind", "outputPath", "outputAssetKey", "canvas"],
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,99}$"},
    "kind": {
      "enum": ["STATIC_FURNITURE", "ANIMATED_FURNITURE", "CHARACTER_ANIMATION", "HOUSE_FRAME"]
    },
    "themeCode": {"type": ["string", "null"]},
    "sourcePath": {"type": ["string", "null"]},
    "outputPath": {"type": "string", "minLength": 1},
    "sourceAssetKey": {"type": ["string", "null"]},
    "outputAssetKey": {"type": "string", "minLength": 1},
    "previewAssetKey": {"type": ["string", "null"]},
    "targetItemId": {"type": ["integer", "null"], "minimum": 1},
    "expectedOldAssetKey": {"type": ["string", "null"]},
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "alphaBorderMax": {"type": "integer", "minimum": 0, "maximum": 255, "default": 0},
    "animation": {
      "type": "object",
      "properties": {
        "expectedFrames": {"type": "integer", "minimum": 2},
        "requireInfiniteLoop": {"type": "boolean", "default": true},
        "previewSizes": {"type": "array", "items": {"type": "integer", "minimum": 16}},
        "minVisibleDeltaPercent": {"type": "number", "minimum": 0},
        "protectedMaskPath": {"type": ["string", "null"]}
      }
    },
    "transparentSlots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": {"type": "integer", "minimum": 0},
          "y": {"type": "integer", "minimum": 0},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "additionalProperties": true
}
